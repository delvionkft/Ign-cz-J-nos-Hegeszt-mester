# ---------------------------------------------------------------------------
# KÖRNYEZETI VÁLTOZÓK
# Másold `.env` néven, és töltsd ki a valós értékekkel.
# Vite-ban csak a VITE_ előtaggal kezdődő változók kerülnek a kliensbe.
# FONTOS: ide SOHA ne kerüljön titkos kulcs vagy API secret – a kliensoldali
# build tartalma bárki számára olvasható.
# ---------------------------------------------------------------------------

# Az oldal éles URL-je (canonical, Open Graph, structured data)
VITE_SITE_URL=https://pelda.hu

# --- Ajánlatkérő űrlap bekötése -------------------------------------------
# A POST végpont, ahova a lead érkezik (saját backend, CRM webhook, form szolgáltatás).
# Amíg üres: fejlesztői módban szimulált beküldés, production buildben az űrlap
# NEM mutat sikeres állapotot, hanem a telefonos / WhatsApp elérhetőségre irányít.
VITE_FORM_ENDPOINT=

# multipart = fájlfeltöltéssel (alapértelmezett) | json = fájlok nélkül, csak mezők
VITE_FORM_MODE=multipart

# --- Elérhetőségek ---------------------------------------------------------
# Ezek felülírják a src/content/site.config.ts megfelelő mezőit.
VITE_PHONE_DISPLAY=
VITE_PHONE_HREF=
VITE_WHATSAPP_NUMBER=
VITE_VIBER_NUMBER=
VITE_EMAIL=

# --- Mérés -----------------------------------------------------------------
# Üresen hagyva SEMMILYEN mérőkód nem töltődik be, és a süti sáv sem jelenik meg.
# A kódok kizárólag marketing hozzájárulás után kerülnek betöltésre.
VITE_GA4_ID=
VITE_GTM_ID=
VITE_META_PIXEL_ID=

# --- Élesítési ellenőrzés --------------------------------------------------
# true esetén a `npm run check:content` beépíthető a build folyamatba.
VITE_REQUIRE_COMPLETE_CONTENT=false
